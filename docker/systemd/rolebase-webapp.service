[Unit]
Description=Rolebase webapp (static build preview server)
After=network-online.target rolebase-backend.service
Wants=network-online.target

[Service]
Type=simple
User=raoul
WorkingDirectory=/home/raoul/DevSite/Rolebase/packages/webapp
# npx and the tools it starts resolve `node` from PATH: use the nvm Node, not the system one
Environment=PATH=/home/raoul/.nvm/versions/node/v24.21.0/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/raoul/.nvm/versions/node/v24.21.0/bin/npx vite preview --port 3032 --host
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
